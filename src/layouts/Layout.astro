---
import '../styles/global.css';
import LottieAnimation from 'astro-integration-lottie/Lottie.astro'

const description = '¡Hola! Soy Luz Natalia y estoy emocionada de invitarte a mi fiesta de XV años. Será una noche mágica llena de sorpresas, música y baile. ¡No puedo esperar para celebrar contigo!';
const title = 'XV Luz Natalia';
const image = 'https://res.cloudinary.com/ddclkt7n4/image/upload/v1753154153/2_2_aea56p.jpg';
const url = 'https://luz.kysedomi.lat';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Parisienne&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>XV Luz Natalia</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={url} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<meta name="twitter:url" content={url} />

		<style>
			h1, h2, h3, h4 {
				font-family: 'Parisienne', cursive !important;
				letter-spacing: 0.5px;
			}
			p {
				font-family: 'Montserrat', sans-serif !important;
			}
			#music-controls {
				position: fixed;
				top: 1.5rem;
				left: 1.5rem;
				z-index: 9999;
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 0.7rem;
			}
			#music-toggle {
				background: linear-gradient(135deg, #EDDADA 60%, #CB8587 100%);
				border: 2px solid #8E8B63;
				box-shadow: 0 2px 12px rgba(142,139,99,0.15);
				border-radius: 9999px;
				padding: 0.6rem 1rem;
				font-size: 1.7rem;
				cursor: pointer;
				transition: background 0.3s, box-shadow 0.3s, border 0.3s;
				color: #8E8B63;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}
			#music-toggle:hover {
				background: linear-gradient(135deg, #CB8587 60%, #EDDADA 100%);
				box-shadow: 0 4px 16px rgba(142,139,99,0.25);
				border-color: #CB8587;
			}
			#volume-toggle {
				background: linear-gradient(135deg, #EDDADA 60%, #CB8587 100%);
				border: 2px solid #8E8B63;
				box-shadow: 0 2px 12px rgba(142,139,99,0.10);
				border-radius: 9999px;
				padding: 0.3rem 0.7rem;
				font-size: 1.1rem;
				color: #8E8B63;
				cursor: pointer;
				transition: background 0.3s, box-shadow 0.3s, border 0.3s;
				margin-top: 0.1rem;
				display: flex;
				align-items: center;
				gap: 0.3rem;
			}
			#volume-toggle:hover {
				background: linear-gradient(135deg, #CB8587 60%, #EDDADA 100%);
				box-shadow: 0 4px 16px rgba(142,139,99,0.18);
				border-color: #CB8587;
			}
			#volume-slider {
				width: 120px;
				background: rgba(255,255,255,0.85);
				border-radius: 9999px;
				padding: 0.3rem 0.7rem;
				box-shadow: 0 2px 8px rgba(142,139,99,0.10);
				border: 1px solid #CB8587;
				display: flex;
				align-items: center;
				gap: 0.5rem;
				opacity: 1;
				visibility: visible;
				transition: opacity 0.3s, visibility 0.3s, max-height 0.3s;
				max-height: 60px;
			}
			#volume-slider.hidden {
				opacity: 0;
				visibility: hidden;
				max-height: 0;
				overflow: hidden;
			}
			#volume-slider input[type="range"] {
				width: 80px;
				accent-color: #CB8587;
				background: transparent;
				cursor: pointer;
			}
			#volume-slider label {
				font-size: 1.1rem;
				color: #8E8B63;
				font-family: 'Montserrat', sans-serif;
				font-weight: bold;
			}
			@media (max-width: 600px) {
				#music-controls {
					top: 0.7rem;
					left: 0.7rem;
					gap: 0.5rem;
				}
				#music-toggle {
					font-size: 1.2rem;
					padding: 0.4rem 0.7rem;
				}
				#volume-toggle {
					font-size: 1rem;
					padding: 0.3rem 0.6rem;
				}
				#volume-slider {
					width: 90px;
					padding: 0.2rem 0.4rem;
				}
				#volume-slider input[type="range"] {
					width: 55px;
				}
			}
		</style>
	</head>
	<body>
		<!-- Preloader -->
		<div id="preloader" style="
			position: fixed;
			inset: 0;
			width: 100vw;
			height: 100vh;
			background: linear-gradient(135deg, #EDDADA 60%, #CB8587 100%);
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			z-index: 99999;
			transition: opacity 0.6s;
		">
			<div style="width: 180px; max-width: 80vw;">
				<LottieAnimation src='/totorowalk.json' autoplay="visible"/>
			</div>
			<p id="loading-text" style="
				margin-top: 2rem;
				font-family: 'Montserrat', sans-serif;
				font-size: 1.5rem;
				color: #8E8B63;
				font-weight: 600;
				letter-spacing: 1px;
				text-shadow: 0 2px 8px #EDDADA;
			">
				Cargando...
			</p>
			<!-- Botón Comenzar oculto al inicio -->
			<button id="start-btn" style="
				margin-top: 2.5rem;
				padding: 0.8rem 2.2rem;
				font-size: 1.4rem;
				border-radius: 9999px;
				border: 2px solid #8E8B63;
				background: linear-gradient(135deg, #CB8587 60%, #EDDADA 100%);
				color: #8E8B63;
				font-family: 'Montserrat', sans-serif;
				font-weight: bold;
				cursor: pointer;
				box-shadow: 0 2px 12px rgba(142,139,99,0.10);
				display: none;
				transition: background 0.3s, color 0.3s, border 0.3s;
			">Comenzar</button>
		</div>
		<!-- Fin Preloader -->

		<slot />

		<audio id="bg-music" autoplay loop>
			<source src="/music/cancion.mp3" type="audio/mpeg" />
			Tu navegador no soporta el audio.
		</audio>

		<div id="music-controls">
			<button id="music-toggle" aria-label="Toggle music">
				<span id="music-icon">
					<!-- SVGs para los estados de música -->
					<svg id="icon-sound-on" xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24"><path fill="#8E8B63" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3a4.5 4.5 0 0 1-2.25 3.89v-7.78A4.5 4.5 0 0 1 16.5 12zm2.5 0a7 7 0 0 1-3.5 6.06v-2.06a5 5 0 0 0 0-8v-2.06A7 7 0 0 1 19 12z"/></svg>
					<svg id="icon-sound-off" xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" style="display:none;"><path fill="#8E8B63" d="M16.5 12a4.5 4.5 0 0 1-2.25 3.89v-7.78A4.5 4.5 0 0 1 16.5 12zm2.5 0a7 7 0 0 1-3.5 6.06v-2.06a5 5 0 0 0 0-8v-2.06A7 7 0 0 1 19 12z"/><path fill="#8E8B63" d="M3 9v6h4l5 5V4L7 9H3zm16.5-1.5-13 13"/></svg>
					<svg id="icon-sound-low" xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" style="display:none;"><path fill="#8E8B63" d="M3 9v6h4l5 5V4L7 9H3zm7 3a4.5 4.5 0 0 1 2.25 3.89v-7.78A4.5 4.5 0 0 1 10 12z"/></svg>
				</span>
			</button>
			<button id="volume-toggle" aria-label="Mostrar/ocultar volumen">
				<span id="volume-toggle-icon">
					<!-- SVG para mostrar/ocultar -->
					<svg id="icon-slider" xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="4" rx="2" fill="#8E8B63"/><circle cx="12" cy="12" r="3" fill="#CB8587" stroke="#8E8B63" stroke-width="1"/></svg>
					<svg id="icon-chevron-up" xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" style="display:none;"><path stroke="#8E8B63" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M6 15l6-6 6 6"/></svg>
				</span>
			</button>
			<div id="volume-slider">
				<label for="slider-vol" id="volume-label">
					<!-- SVG volumen bajo -->
					<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24"><path fill="#8E8B63" d="M3 9v6h4l5 5V4L7 9H3zm7 3a4.5 4.5 0 0 1 2.25 3.89v-7.78A4.5 4.5 0 0 1 10 12z"/></svg>
				</label>
				<input type="range" id="slider-vol" min="0" max="100" value="80" />
			</div>
		</div>

		<script>
			// Preloader con botón "Comenzar"
			window.addEventListener('DOMContentLoaded', () => {
				const preloader = document.getElementById('preloader');
				const audio = document.getElementById('bg-music');
				const startBtn = document.getElementById('start-btn');
				const loadingText = document.getElementById('loading-text');
				setTimeout(() => {
					startBtn.style.display = 'block';
					if (loadingText) loadingText.style.display = 'none';
				}, 5000); // Mostrar botón después de 5 segundos

				startBtn.addEventListener('click', () => {
					preloader.style.opacity = '0';
					setTimeout(() => {
						preloader.style.display = 'none';
						// Inicia la música después del loader
						audio.play().catch(() => {
							console.log('Error al reproducir la música. Puede que el navegador bloquee la reproducción automática.');
						});
					}, 600);
				});
			});

			const audio = document.getElementById('bg-music');
			const toggleBtn = document.getElementById('music-toggle');
			const musicIcon = document.getElementById('music-icon');
			const iconSoundOn = document.getElementById('icon-sound-on');
			const iconSoundOff = document.getElementById('icon-sound-off');
			const iconSoundLow = document.getElementById('icon-sound-low');
			const slider = document.getElementById('slider-vol');
			const volumeSlider = document.getElementById('volume-slider');
			const volumeToggle = document.getElementById('volume-toggle');
			const volumeToggleIcon = document.getElementById('volume-toggle-icon');
			const iconSlider = document.getElementById('icon-slider');
			const iconChevronUp = document.getElementById('icon-chevron-up');
			const volumeLabel = document.getElementById('volume-label');

			let isPlaying = true;
			let volumeVisible = false;

			function setMusicIcon(vol, playing) {
				iconSoundOn.style.display = 'none';
				iconSoundOff.style.display = 'none';
				iconSoundLow.style.display = 'none';
				if (!playing || vol === 0) {
					iconSoundOff.style.display = '';
				} else if (vol < 0.5) {
					iconSoundLow.style.display = '';
				} else {
					iconSoundOn.style.display = '';
				}
			}

			// Inicializa volumen
			audio.volume = slider.value / 100;
			setMusicIcon(audio.volume, isPlaying);

			toggleBtn.addEventListener('click', () => {
				if (isPlaying) {
					audio.pause();
					setMusicIcon(audio.volume, false);
					toggleBtn.style.opacity = 0.7;
				} else {
					audio.play();
					setMusicIcon(audio.volume, true);
					toggleBtn.style.opacity = 1;
				}
				isPlaying = !isPlaying;
			});

			slider.addEventListener('input', (e) => {
				const vol = e.target.value / 100;
				audio.volume = vol;
				setMusicIcon(vol, isPlaying);
			});

			audio.addEventListener('volumechange', () => {
				setMusicIcon(audio.volume, isPlaying);
			});

			volumeToggle.addEventListener('click', () => {
				volumeVisible = !volumeVisible;
				if (volumeVisible) {
					volumeSlider.classList.remove('hidden');
					iconSlider.style.display = 'none';
					iconChevronUp.style.display = '';
				} else {
					volumeSlider.classList.add('hidden');
					iconSlider.style.display = '';
					iconChevronUp.style.display = 'none';
				}
			});

			// Oculta el control de volumen al inicio
			volumeSlider.classList.add('hidden');
			iconSlider.style.display = '';
			iconChevronUp.style.display = 'none';
		</script>
	</body>
</html>

