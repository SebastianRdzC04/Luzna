---
---

<div class="w-full h-screen bg-[url('/fotosLuz/ultimafoto.jpg')] bg-cover bg-center flex items-center justify-center relative">
  <div
    id="animado-instagram"
    class="relative h-[60%] w-[90%] max-w-md z-10 flex flex-col items-center justify-center rounded-2xl text-center px-6 py-12 mx-auto bg-white/10 backdrop-blur-sm shadow-2xl border opacity-0"
    style="color: var(--color-2); border-color: var(--color-2);"
  >
    <h2
      class="text-3xl text-white font-bold mb-4"
      style=""
    >
      ¡Sigueme en Instagram!
    </h2>
    <p class="mb-8 text-lg text-[#EDDADA] font-bold" style="">
      Comparte conmigo las fotos que tomes en la celebración y no olvides usar el hashtag <span class="text-[#CB8587]">#Luz15Años</span> para que pueda verlas todas.
    </p>
    <a
      href="https://instagram.com/TU_USUARIO_AQUI"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-3 font-semibold py-3 px-8 rounded-lg transition-colors shadow-lg"
      style="
        background: linear-gradient(90deg, var(--color-3) 0%, var(--color-1) 100%);
        color: #fff;
      "
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 32 32" class="w-7 h-7">
        <rect width="32" height="32" rx="8" fill="url(#ig-gradient)"/>
        <defs>
          <linearGradient id="ig-gradient" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
            <stop stop-color="#CB8587"/>
            <stop offset="1" stop-color="#D6D4AD"/>
          </linearGradient>
        </defs>
        <path fill="#fff" d="M16 10.8a5.2 5.2 0 1 0 0 10.4 5.2 5.2 0 0 0 0-10.4Zm0 8.6a3.4 3.4 0 1 1 0-6.8 3.4 3.4 0 0 1 0 6.8Zm6.6-8.8a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0Zm3.4 1.2c-.1-1.4-.4-2.4-1-3.3a5.5 5.5 0 0 0-3.3-1c-1.3-.1-5.2-.1-6.5 0-1.4.1-2.4.4-3.3 1a5.5 5.5 0 0 0-1 3.3c-.1 1.3-.1 5.2 0 6.5.1 1.4.4 2.4 1 3.3a5.5 5.5 0 0 0 3.3 1c1.3.1 5.2.1 6.5 0 1.4-.1 2.4-.4 3.3-1a5.5 5.5 0 0 0 1-3.3c.1-1.3.1-5.2 0-6.5Zm-2.1 8.1a3.1 3.1 0 0 1-1.8 1.8c-.6.2-2.1.4-4.1.4s-3.5-.1-4.1-.4a3.1 3.1 0 0 1-1.8-1.8c-.2-.6-.4-2.1-.4-4.1s.1-3.5.4-4.1a3.1 3.1 0 0 1 1.8-1.8c.6-.2 2.1-.4 4.1-.4s3.5.1 4.1.4a3.1 3.1 0 0 1 1.8 1.8c.2.6.4 2.1.4 4.1s-.1 3.5-.4 4.1Z"/>
      </svg>
      Seguir en Instagram
    </a>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const elInstagram = document.getElementById('animado-instagram');
      if (elInstagram) {
        const observerInstagram = new IntersectionObserver(
          (entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                elInstagram.classList.add('animate-fade');
                elInstagram.classList.remove('opacity-0');
                elInstagram.classList.add('opacity-100');
              } else {
                elInstagram.classList.remove('animate-fade');
                elInstagram.classList.remove('opacity-100');
                elInstagram.classList.add('opacity-0');
              }
            });
          },
          { threshold: 0.2 }
        );
        observerInstagram.observe(elInstagram);
      }
    });
  </script>
</div>